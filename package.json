{
  "name": "bangle-io",
  "version": "1.0.1",
  "authors": [
    {
      "name": "Kushan Joshi",
      "email": "0o3ko0@gmail.com",
      "web": "http://github.com/kepta"
    }
  ],
  "bugs": "https://github.com/bangle-io/bangle-io/issues",
  "devDependencies": {
    "@bangle.io/env-vars": "workspace:*",
    "@bangle.io/plop-configs": "workspace:*",
    "@bangle.io/translations": "workspace:*",
    "@bangle.io/types": "workspace:*",
    "@biomejs/biome": "2.5.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@typescript/native-preview": "7.0.0-dev.20260702.3",
    "@vitest/browser": "^4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "knip": "^6.24.0",
    "plop": "^4.0.5",
    "tslib": "^2.8.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  },
  "homepage": "https://bangle.io",
  "license": "AGPL-3.0-or-later",
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "quoteProps": "consistent",
    "arrowParens": "always",
    "printWidth": 80
  },
  "private": true,
  "scripts": {
    "build": "pnpm run precursor && pnpm -r --filter \"browser-entry\" run build",
    "cf:login": "wrangler login",
    "cf:pages:deploy:production": "wrangler pages deploy packages/tooling/browser-entry/dist --branch production",
    "cf:pages:deploy:staging": "wrangler pages deploy packages/tooling/browser-entry/dist --branch staging",
    "cf:pages:download-config": "wrangler pages download config",
    "cf:pages:list": "wrangler pages project list",
    "cf:whoami": "wrangler whoami",
    "custom-validation": "bun packages/tooling/custom-scripts/scripts/validate-all.ts",
    "custom-format": "bun packages/tooling/custom-scripts/scripts/format-package-json.ts",
    "desktop:build": "pnpm run build && pnpm --filter \"@bangle.io/desktop-entry\" run build",
    "desktop:ci": "pnpm --filter \"@bangle.io/desktop-entry\" run ci",
    "desktop:dist": "pnpm --filter \"@bangle.io/desktop-entry\" run dist",
    "desktop:open": "pnpm desktop:build && BANGLE_DESKTOP_BROWSER_DIST=\"$PWD/packages/tooling/browser-entry/dist\" pnpm --filter \"@bangle.io/desktop-entry\" exec electron \"$PWD/packages/tooling/desktop-entry/dist/main.cjs\"",
    "desktop:release:stable": "pnpm --filter \"@bangle.io/desktop-entry\" run release:stable",
    "dev-ports": "node scripts/dev-ports.js",
    "lint:ci": "pnpm run custom-validation && pnpm run typecheck && biome ci .  --diagnostic-level=error",
    "test:ci": "pnpm vitest run --configLoader runner --maxWorkers=50%",
    "e2e-install": "pnpm --filter \"@bangle.io/e2e-tests\" exec playwright install --with-deps chromium",
    "e2e:ci": "pnpm --filter \"@bangle.io/e2e-tests\" run ci && pnpm run e2e-ct-test",
    "e2e-ui-mode": "pnpm --filter \"@bangle.io/e2e-tests\" run test-ui-mode",
    "e2e-ct-test": "pnpm --filter \"@bangle.io/e2e-tests\" run test-ct",
    "e2e-update-snapshots": "pnpm --filter \"@bangle.io/e2e-tests\" run test --update-snapshots",
    "e2e-ct-update-snapshots": "pnpm --filter \"@bangle.io/e2e-tests\" run test-ct --update-snapshots",
    "build-color-scheme-manager": "pnpm -r --filter \"@bangle.io/color-scheme-manager\" run build",
    "knip": "knip",
    "knip:ci": "pnpm run knip && pnpm run knip:production && pnpm run knip:production-dependencies && pnpm run knip:production-unlisted",
    "knip:production": "knip -c knip.production.json --production",
    "knip:production-dependencies": "knip -c knip.production-dependencies.json --production --strict --include dependencies --workspace @bangle.io/browser-entry --workspace @bangle.io/desktop-entry --workspace @bangle.io/mobile-entry",
    "knip:production-unlisted": "knip -c knip.production-unlisted.json --production --strict --include unlisted,binaries --workspace @bangle.io/browser-entry --workspace @bangle.io/desktop-entry --workspace @bangle.io/mobile-entry",
    "lint:fix": "biome check . --fix",
    "lint": "biome check .",
    "local-ci-check": "bash local-ci-check.sh",
    "plop": "plop",
    "precursor": "echo \"ok\"",
    "preview-production": "pnpm -r --filter \"browser-entry\" run preview-production",
    "start": "pnpm -r --filter \"browser-entry\" run dev",
    "storybook": "pnpm -r --filter \"storybook\" run storybook",
    "typecheck": "tsgo -b tsconfig.tsgo.json && pnpm --filter \"@bangle.io/mobile-entry\" run typecheck"
  },
  "type": "module",
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}

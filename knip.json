{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true,
  "workspaces": {
    ".": {
      "entry": [".github/scripts/**/*.cjs"],
      "ignoreDependencies": [
        "@bangle.io/types",
        "@storybook/react",
        "@storybook/react-vite",
        "storybook"
      ],
      "project": ["*.{js,ts}", ".github/scripts/**/*.cjs"]
    },
    "packages/js-lib/color-scheme-manager": {
      "ignoreBinaries": ["tsc"]
    },
    "packages/tooling/browser-entry": {
      "entry": ["index.html"],
      "ignoreFiles": ["src/default-theme.css"],
      "project": ["src/**/*.{css,ts,tsx}", "translations-plugin.ts"],
      "vite": {
        "config": ["vite.config.ts"]
      }
    },
    "packages/tooling/custom-scripts": {
      "entry": ["scripts/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/tooling/desktop-entry": {
      "entry": [
        "electron-builder.config.cjs",
        "scripts/*.{mjs,ts}",
        "src/main.ts",
        "src/preload.ts"
      ],
      "project": ["scripts/*.{mjs,ts}", "src/**/*.ts"],
      "vite": {
        "config": ["vite.config.ts"]
      }
    },
    "packages/tooling/e2e-tests": {
      "entry": [
        "scripts/*.ts",
        "src/**/*.ct.tsx",
        "src/**/*.e2e.ts"
      ],
      "project": [
        "playwright/**/*.{css,ts,tsx}",
        "playwright*.config.ts",
        "scripts/*.ts",
        "src/**/*.{ts,tsx}"
      ],
      "ignoreFiles": ["playwright/index.css"]
    },
    "packages/tooling/mobile-entry": {
      "entry": ["babel.config.js"],
      "ignoreBinaries": ["eas"],
      "ignoreDependencies": ["expo-system-ui", "expo-updates"],
      "project": ["*.{js,ts}", "src/**/*.tsx"],
      "expo": {
        "config": ["app.config.ts"]
      }
    },
    "packages/tooling/plop-configs": {
      "ignoreBinaries": ["custom-format"]
    },
    "packages/tooling/storybook": {
      "entry": ["src/**/*.stories.{ts,tsx}"],
      "project": ["**/*.{css,js,ts,tsx}"],
      "storybook": {
        "entry": ["src/**/*.stories.{ts,tsx}"]
      }
    },
    "packages/ui/ui-components": {
      "entry": ["testing.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error",
    "catalog": "error"
  }
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "include": [
    "files",
    "exports",
    "nsExports",
    "types",
    "nsTypes",
    "enumMembers",
    "namespaceMembers",
    "duplicates"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreFiles": [
    "**/__tests__/**",
    "**/*.spec.{ts,tsx}",
    "**/*.stories.portable.tsx",
    "packages/ui/ui-components/testing.ts",
    "**/test-helpers/**",
    "packages/tooling/test-utils/scripts/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        ".github/scripts/**/*.cjs"
      ],
      "project": [
        "*.{js,ts}",
        ".github/scripts/**/*.cjs"
      ]
    },
    "packages/tooling/browser-entry": {
      "entry": [
        "index.html"
      ],
      "ignoreFiles": [
        "src/default-theme.css"
      ],
      "project": [
        "src/**/*.{css,ts,tsx}",
        "translations-plugin.ts"
      ],
      "vite": {
        "config": [
          "vite.config.ts"
        ]
      }
    },
    "packages/tooling/custom-scripts": {
      "entry": [
        "scripts/*.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "packages/tooling/desktop-entry": {
      "entry": [
        "electron-builder.config.cjs",
        "scripts/*.{mjs,ts}",
        "src/main.ts",
        "src/preload.ts"
      ],
      "project": [
        "scripts/*.{mjs,ts}",
        "src/**/*.ts"
      ],
      "vite": {
        "config": [
          "vite.config.ts"
        ]
      }
    },
    "packages/tooling/e2e-tests": {
      "entry": [
        "playwright*.config.ts",
        "playwright/index.tsx",
        "scripts/*.ts",
        "src/**/*.ct.tsx",
        "src/**/*.e2e.ts"
      ],
      "project": [
        "playwright/**/*.{css,html,ts,tsx}",
        "playwright*.config.ts",
        "scripts/*.ts",
        "src/**/*.{ts,tsx}"
      ],
      "ignoreFiles": [
        "playwright/index.css"
      ]
    },
    "packages/tooling/mobile-entry": {
      "entry": [
        "babel.config.js",
        "index.ts",
        "src/**/*.tsx"
      ],
      "project": [
        "*.{js,ts}",
        "src/**/*.tsx"
      ],
      "expo": {
        "config": [
          "app.config.ts"
        ]
      }
    },
    "packages/tooling/storybook": {
      "entry": [
        "src/**/*.stories.{ts,tsx}"
      ],
      "project": [
        "**/*.{css,js,ts,tsx}"
      ],
      "storybook": {
        "entry": [
          "src/**/*.stories.{ts,tsx}"
        ]
      }
    }
  },
  "rules": {
    "files": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error"
  }
}

{
  "id": "/",
  "name": "Bangle.io",
  "short_name": "Bangle.io",
  "description": "Local-first Markdown notes.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://app.bangle.io/manifest.webmanifest",
      "id": "https://app.bangle.io/"
    },
    {
      "platform": "webapp",
      "url": "/manifest.webmanifest",
      "id": "/"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+bangle",
      "url": "/?launch=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "New note",
      "url": "/?shortcut=new-note",
      "icons": [
        {
          "src": "/icons/app-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Search notes",
      "url": "/?shortcut=search",
      "icons": [
        {
          "src": "/icons/app-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/markdown": [".md", ".markdown"]
      }
    }
  ],
  "icons": [
    {
      "src": "/icons/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}

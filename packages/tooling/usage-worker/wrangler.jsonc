{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "bangle-usage",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "https://app.bangle.io/api/usage", "zone_name": "bangle.io" }
  ],
  "d1_databases": [
    {
      "binding": "USAGE_DB",
      "database_name": "bangle-usage",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "USAGE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false }
}
